<Window x:Class="MinecraftInstanceMigration.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft Instance Migration"
        Width="640" Height="360" MinWidth="480" MinHeight="280">
  <Grid Margin="32">
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Minecraft Instance Migration"
                 FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Margin="0,16,0,0"
                 Text="Phase 0 — Development foundation"
                 FontSize="16" TextWrapping="Wrap" />
      <TextBlock Margin="0,8,0,0"
                 Text="Migration features are not available yet. This shell does not inspect or change your Minecraft instances."
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
