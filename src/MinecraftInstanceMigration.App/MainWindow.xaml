<Window x:Class="MinecraftInstanceMigration.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft Instance Migration"
        Width="980" Height="760" MinWidth="760" MinHeight="560">
  <Grid Margin="20">
    <TabControl>
      <TabItem Header="Inspector">
        <Grid Margin="12" DataContext="{Binding Inspector}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Read-only Instance Inspector" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap"
                       Text="Observes the selected folder and 11 known direct children. No copying, content reads, or changes. Results do not confirm a Minecraft instance or migration compatibility." />
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Padding="6" AutomationProperties.Name="Candidate folder"
                     AutomationProperties.AutomationId="CandidatePath"
                     Text="{Binding CandidatePath, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditPath}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,6" Content="Browse…"
                    Command="{Binding BrowseCommand}" />
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12">
            <Button Content="Inspect" Padding="20,6" Command="{Binding InspectCommand}"
                    AutomationProperties.AutomationId="Inspect" />
            <Button Content="Cancel" Padding="20,6" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="Cancel" />
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="Status" />
            <TextBlock Margin="0,8,0,0" Text="{Binding RootState, StringFormat=Root state: {0}}"
                       FontWeight="SemiBold" AutomationProperties.AutomationId="RootState" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
          </StackPanel>
          <DataGrid Grid.Row="4" ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                    IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" AutomationProperties.Name="Observed entries"
                    AutomationProperties.AutomationId="Entries">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Expected kind" Binding="{Binding ExpectedKind}" Width="130" />
              <DataGridTextColumn Header="Observed state" Binding="{Binding State}" Width="150" />
              <DataGridTextColumn Header="Kind matches" Binding="{Binding MatchesExpectedKind, TargetNullValue=Unknown}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="Missing = absent. Inaccessible / Unavailable = unknown. A reparse point is recorded without following it; a reparse point in the root path stops inspection." />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Use an absolute local drive path. Network and device paths are unsupported. Cancellation takes effect between metadata calls. Observations can become stale." />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Migration Preview" AutomationProperties.AutomationId="PreviewTab">
        <Grid Margin="12" DataContext="{Binding Preview}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Preview / Dry Run" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap"
                       Text="Inspects source and destination, applies the Recommended selection preset, and shows the resulting plan. No files are copied, replaced, deleted, backed up, or modified." />
          </StackPanel>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Source" />
            <TextBox Grid.Column="1" Padding="6"
                     AutomationProperties.AutomationId="PreviewSourcePath"
                     Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditPaths}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="16,6" Content="Browse…"
                    Command="{Binding BrowseSourceCommand}" />
          </Grid>

          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Destination" />
            <TextBox Grid.Column="1" Padding="6"
                     AutomationProperties.AutomationId="PreviewDestinationPath"
                     Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditPaths}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="16,6" Content="Browse…"
                    Command="{Binding BrowseDestinationCommand}" />
          </Grid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12">
            <Button Content="Generate Preview" Padding="20,6" Command="{Binding GeneratePreviewCommand}"
                    AutomationProperties.AutomationId="GeneratePreview" />
            <Button Content="Apply choices" Padding="20,6" Margin="8,0,0,0"
                    Command="{Binding ApplyChoicesCommand}"
                    AutomationProperties.AutomationId="ApplyPreviewChoices" />
            <Button Content="Reset Recommended" Padding="20,6" Margin="8,0,0,0"
                    Command="{Binding ResetRecommendedCommand}"
                    AutomationProperties.AutomationId="ResetRecommendedChoices" />
            <Button Content="Cancel" Padding="20,6" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="PreviewCancel" />
          </StackPanel>

          <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="PreviewStatus" />
            <TextBlock Margin="0,8,0,0" Text="{Binding PlanStatus, StringFormat=Plan status: {0}}"
                       FontWeight="SemiBold" AutomationProperties.AutomationId="PreviewPlanStatus" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="PreviewSummary" />
          </StackPanel>

          <DataGrid Grid.Row="5" ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                    IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" AutomationProperties.Name="Migration preview entries"
                    AutomationProperties.AutomationId="PreviewEntries">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="Selected"
                                      Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="80" />
              <DataGridTemplateColumn Header="Conflict" Width="125">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding ConflictOptions}"
                              SelectedItem="{Binding ConflictDecision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanChooseConflict}"
                              AutomationProperties.Name="{Binding Name, StringFormat={}{0} conflict decision}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110" IsReadOnly="True" />
              <DataGridTextColumn Header="Plan detail" Binding="{Binding PlanDisposition}" Width="190" IsReadOnly="True" />
              <DataGridTextColumn Header="Source" Binding="{Binding SourceState, TargetNullValue=Unknown}" Width="115" IsReadOnly="True" />
              <DataGridTextColumn Header="Destination" Binding="{Binding DestinationState, TargetNullValue=Unknown}" Width="115" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="Backup" Binding="{Binding RequiresBackup}" Width="75" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="6" Margin="0,12,0,0" TextWrapping="Wrap"
                     Text="Recommended leaves saves and screenshots unselected. Edit selection, choose Skip or Replace for visible destination conflicts, then Apply choices. Preview remains metadata-only and never authorizes writes; observations can become stale." />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
